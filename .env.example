# Original managed-hosting profile. For a VPS deployment, see deploy/docker/app.env.example
# or deploy/vps/env.vps.example and docs/deploiement-vps.md.
APP_NAME="myABI · ARGE-ABI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-account.alwaysdata.net
APP_LOCALE=de
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=UTC
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mariadb
DB_HOST=mysql-your-account.alwaysdata.net
DB_PORT=3306
DB_DATABASE=your-account_myabi
DB_USERNAME=your-account_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Minimum password length for all password creation and change flows.
AUTH_PASSWORD_MIN_LENGTH=8
# Global MFA switch: true enables TOTP challenges and role requirements.
MFA_ENABLED=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Opt in only when a dedicated Unix group shares web/CLI private storage.
PRIVATE_SHARED_GROUP=false
MAIL_MAILER=smtp
MAIL_HOST=smtp-your-account.alwaysdata.net
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=referentiel@example.org
MAIL_FROM_NAME="ARGE-ABI"
STORAGE_QUOTA_BYTES=1073741824
# Email, other sites, retained deployments, and any provider-counted space
# missing from the SQL table estimate (reconcile against the account meter).
EXTERNAL_STORAGE_USED_BYTES=0
RELEASE_VERSION=dev
