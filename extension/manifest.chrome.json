{
    "manifest_version": 3,
    "name": "MyAB Translation Inspector",
    "version": "0.0.0",
    "description": "Alt+clic sur un texte de MyAB pour retrouver sa clé de traduction. Ne modifie jamais MyAB.",
    "minimum_chrome_version": "110",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "MyAB Translation Inspector",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["storage", "scripting"],
    "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
    "commands": {
        "toggle-inspector": {
            "suggested_key": {
                "default": "Alt+Shift+M"
            },
            "description": "Activer / désactiver le mode inspecteur"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
