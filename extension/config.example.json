{
    "apiUrl": "https://translations.example.test/api/browser-extension",
    "appUrl": "https://translations.example.test",
    "allowedDomains": ["myab.example.test", "*.myab-test.example.test"],
    "uiLanguage": "auto",
    "activationModifier": "alt",
    "maxResults": 5,
    "collectContext": true,
    "urlMode": "noQuery",
    "timeoutMs": 10000,
    "feedbackEnabled": false,
    "tokenPersistence": "local",
    "manualSearchUrlTemplate": "{appUrl}/terms?q={query}",
    "selectors": {
        "breadcrumb": "",
        "dialog": "",
        "sectionTitle": "",
        "ignore": ""
    }
}
