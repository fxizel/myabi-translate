# Copy to /srv/myabi/shared/.env after filling EVERY REPLACE_* value.
# Owner myabi-deploy:myabi-web, mode 0640; never commit the populated file.
APP_NAME="myABI · ARGE-ABI"
APP_ENV=production
APP_KEY=REPLACE_WITH_GENERATED_APP_KEY
APP_DEBUG=false
APP_URL=https://myabi.example.org
APP_LOCALE=de
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=UTC
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# MariaDB 11.4 on this VPS; do not expose port 3306 to the Internet.
# This is the limited application account, NEVER the migration account.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myabi
DB_USERNAME=myabi_app
DB_PASSWORD=REPLACE_WITH_APPLICATION_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Minimum password length for all password creation and change flows.
AUTH_PASSWORD_MIN_LENGTH=8
# Global MFA switch: true enables TOTP challenges and role requirements.
MFA_ENABLED=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Native deployment only: cooperate with the distinct FPM Unix account.
PRIVATE_SHARED_GROUP=true

# Use the organization's existing SMTP service; no local mail server is required.
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=REPLACE_WITH_AUTHORIZED_SENDER
MAIL_FROM_NAME="ARGE-ABI"

# Integers in BYTES, measured against the selected site/disk allocation.
# Includes live code, runtime, originals, history, publications and SQL.
# Reserve capacity for a new release, growing data and verified backups.
# Do not copy the former alwaysdata/local 1 GiB assumption to this VPS.
STORAGE_QUOTA_BYTES=REPLACE_WITH_MEASURED_ALLOCATION_BYTES
# Anything counted in the allocation but missing from the application estimate:
# other releases, other services, backups and physical SQL allocation overhead.
EXTERNAL_STORAGE_USED_BYTES=REPLACE_WITH_MEASURED_EXTERNAL_BYTES
RELEASE_VERSION=dev
