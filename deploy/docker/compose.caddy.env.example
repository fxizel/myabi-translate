# Copy the needed keys into compose.env after the VPS network inventory.
# These example values are NOT the VPS's discovered configuration.
COMPOSE_FILE=compose.yml:compose.caddy.yml
COMPOSE_PATH_SEPARATOR=:
CADDY_NETWORK=REPLACE_WITH_EXISTING_CADDY_NETWORK
# Prefer Caddy's actual stable address /32 (IPv4) or /128 (IPv6).
# A dedicated proxy-only subnet is an alternative if every member is trusted.
CADDY_TRUSTED_PROXY_CIDR=REPLACE_WITH_ACTUAL_CADDY_IP_OR_CIDR
