# Docker can assign PHP a new address after a container recreation.
# resolve is available in the bundled open-source Nginx 1.30.
upstream myabi_php {
    zone myabi_php 64k;
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 2s;
    server myabi-translate-php:9000 resolve;
}

server {
    listen 8080;
    server_name myabi.example.org;
    root /var/www/html/public;
    index index.php;
    server_tokens off;
    client_max_body_size 110m;
    client_body_timeout 1800s;
    # Must be the actual ingress proxy address/subnet, never 0.0.0.0/0.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    # Application audit records useful events without logging query strings or bypass URLs.
    access_log off;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_pass myabi_php;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;
        # Public access is exclusively through the TLS ingress proxy.
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
        fastcgi_param HTTP_PROXY "";
        fastcgi_read_timeout 130s;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
