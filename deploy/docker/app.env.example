APP_NAME="myABI · ARGE-ABI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://myabi.example.org
APP_LOCALE=de
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=UTC
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=myabi
DB_USERNAME=myabi_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Minimum password length for all password creation and change flows.
AUTH_PASSWORD_MIN_LENGTH=8
# Global MFA switch: true enables TOTP challenges and role requirements.
MFA_ENABLED=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
PRIVATE_SHARED_GROUP=true
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_EXISTING_SMTP_SERVER
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=REPLACE_WITH_AUTHORIZED_SENDER
MAIL_FROM_NAME="ARGE-ABI"
# Proposed initial application envelope: 10 GiB out of the reported 30 GB free.
# Confirm against real free space and other services before enabling imports.
STORAGE_QUOTA_BYTES=10737418240
# Reconcile SQL allocation, image layers, logs, backup staging and retained releases.
EXTERNAL_STORAGE_USED_BYTES=0
RELEASE_VERSION=REPLACE_WITH_RELEASE_TAG
